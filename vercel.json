{
  "version": 2,
  "rewrites": [
    { "source": "/api/auth/(.*)", "destination": "/api/auth/index.js" },
    { "source": "/api/rate-limit", "destination": "/api/auth/index.js" },
    { "source": "/api/session", "destination": "/api/auth/index.js" },
    { "source": "/api/logout", "destination": "/api/auth/index.js" },
    { "source": "/api/forgot-password", "destination": "/api/auth/index.js" },
    { "source": "/api/verify-reset-token", "destination": "/api/auth/index.js" },
    { "source": "/api/reset-password", "destination": "/api/auth/index.js" },
    { "source": "/api/validate", "destination": "/api/auth/index.js" },
    { "source": "/api/csrf", "destination": "/api/auth/index.js" },
    { "source": "/database(.*)", "destination": "/404.html" },
    { "source": "/(.*)\\.sql", "destination": "/404.html" },
    { "source": "/(.*)\\.db", "destination": "/404.html" },
    { "source": "/(.*)\\.sqlite", "destination": "/404.html" },
    { "source": "/(.*)\\.zip", "destination": "/404.html" },
    { "source": "/(.*)\\.md", "destination": "/404.html" },
    { "source": "/\\.agents(.*)", "destination": "/404.html" },
    { "source": "/\\.mcp(.*)", "destination": "/404.html" },
    { "source": "/\\.git(.*)", "destination": "/404.html" },
    { "source": "/googleeaacf2e35d237c68.html", "destination": "/googleeaacf2e35d237c68.html" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/tours", "destination": "/tours.html" },
    { "source": "/promoter", "destination": "/promoter.html" },
    { "source": "/protocol", "destination": "/protocol.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/portal", "destination": "/dashboard.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/database/:path*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/(.*)\\.sql",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/(.*)\\.md",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/(.*)\\.zip",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.tixora.live"
        }
      ],
      "destination": "https://tixora.live/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), screen-wake-lock=(), accelerometer=(), gyroscope=(), magnetometer=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https: wss:; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:; object-src 'none'; upgrade-insecure-requests;" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https:; object-src 'none'; upgrade-insecure-requests;" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(posters|artists|ezgif-73126691f624a5ac-jpg)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(webp|jpg|jpeg|png|svg|ico|woff2|gif)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(supabase-config\\.js|auth\\.js|manifest\\.json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
